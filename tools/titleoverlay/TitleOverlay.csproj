<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TitleOverlay</AssemblyName>
    <RootNamespace>TitleOverlay</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>流放之路 头顶称号</Product>
    <AssemblyTitle>流放之路 头顶称号</AssemblyTitle>
  </PropertyGroup>

</Project>
