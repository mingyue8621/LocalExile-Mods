{
  "version": 1,
  "settings": {
    "mode": {
      "type": "choice",
      "default": "extra",
      "options": [
        { "value": "extra", "label": "在服务端掉落之外额外掉" },
        { "value": "only", "label": "取代服务端的掉落" }
      ],
      "label": "掉落模式",
      "description": "选「取代」会取消服务端自己的掉落（装备、宝石、药剂，以及它自己那套通货），只掉下面列的东西。"
    },
    "rarities": {
      "type": "choices",
      "default": ["rare", "unique"],
      "options": [
        { "value": "normal", "label": "普通" },
        { "value": "magic", "label": "魔法" },
        { "value": "rare", "label": "稀有" },
        { "value": "unique", "label": "传奇" }
      ],
      "label": "怪物稀有度",
      "description": "哪些击杀会掉下面列的物品。一个都不勾表示所有怪物。"
    },
    "items": {
      "type": "map",
      "default": {
        "Chaos Orb": 1,
        "Orb of Annulment": 0.05,
        "Exalted Orb": 0.05,
        "Divine Orb": 0.02,
        "Sacred Orb": 0.02,
        "Veiled Chaos Orb": 0.01,
        "Ancient Orb": 0.02,
        "Awakened Sextant": 0.02,
        "Fracturing Orb": 0.01,
        "Hinekora's Lock": 0.005,
        "Mirror of Kalandra": 0.001
      },
      "value": { "type": "number", "min": 0, "max": 1000, "step": 0.001 },
      "label": "每次击杀掉落数",
      "description": "填物品名或 metadata id：每次击杀掉几个。小数表示再多掉一个的概率（0.05 是 5%，2.5 是两个半）。0 表示不掉。"
    },
    "monsters": {
      "type": "list",
      "default": [],
      "maxItems": 64,
      "item": { "type": "text", "maxLength": 120 },
      "label": "仅限这些怪物",
      "description": "留空表示所有怪物。否则怪物的种类 id 或名字要包含其中一项（不区分大小写），例如 Doedre 或 AtlasBosses。"
    }
  }
}
